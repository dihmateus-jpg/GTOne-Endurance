---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const items = [
  { href: '/', label: 'Início' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/circuitos', label: 'Circuitos' },
  { href: '/classificacao', label: 'Tabela' },
  { href: '/midia', label: 'Mídia' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<nav class="tabbar" aria-label="Navegação principal">
  {
    items.map((item) => (
      <a href={item.href} class="tabbar-item" aria-current={isActive(item.href) ? 'page' : undefined}>
        <span class="led" data-active={isActive(item.href)} />
        <span class="tabbar-label">{item.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .tabbar {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    bottom: 0;
    width: 100%;
    max-width: 480px;
    height: var(--h-tabbar);
    display: flex;
    background: var(--surface);
    border-top: 1px solid var(--line);
    z-index: 30;
  }

  @media (min-width: 700px) {
    .tabbar { max-width: 720px; }
  }
  @media (min-width: 1000px) {
    .tabbar { max-width: 960px; }
  }

  .tabbar-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: var(--touch-min);
    text-decoration: none;
  }

  .led {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--led-off);
  }

  .led[data-active='true'] {
    background: var(--accent);
    box-shadow: var(--glow-led);
  }

  .tabbar-label {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .tabbar-item[aria-current='page'] .tabbar-label {
    color: var(--accent);
  }
</style>
