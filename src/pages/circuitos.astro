---
import Base from '../layouts/Base.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { season, circuits } from '../data';
---

<Base title="Circuitos" description="Galeria dos circuitos da temporada Endurance GTOne.">
  <div class="screen">
    <h1 class="screen-title">Circuitos</h1>
    <p class="screen-subtitle">TEMPORADA {String(season.temporada).padStart(2, '0')} · {circuits.length} TRAÇADOS</p>
  </div>

  <section class="section">
    <div class="circuit-grid">
      {
        circuits.map((circuit) => (
          <div class="card circuit-card">
            <div class="track-map">
              {/* trackMapUrl real vem de circuits.json; null hoje = placeholder */}
              {circuit.trackMapUrl ? (
                <img
                  class="track-map-image"
                  src={circuit.trackMapUrl}
                  alt={`Traçado de ${circuit.name}`}
                  loading="lazy"
                />
              ) : (
                <div class="track-map-skeleton" aria-hidden="true">
                  <span class="track-placeholder">MAPA EM BREVE</span>
                </div>
              )}
              <span class="track-badge">{circuit.code}</span>
              {circuit.isFinal && <span class="badge badge-gold track-final">FINAL · ENDURO</span>}
            </div>
            <div class="circuit-info">
              <span class="circuit-name">{circuit.name}</span>
              <span class="circuit-length">{circuit.lengthKm} km</span>
            </div>
            <p class="circuit-highlight">{circuit.highlight}</p>
          </div>
        ))
      }
    </div>
  </section>

  <WhatsAppCTA />
</Base>

<style>
  .circuit-grid {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  @media (min-width: 700px) {
    .circuit-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .circuit-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .circuit-card {
    padding: 0;
    overflow: hidden;
  }

  .track-map {
    position: relative;
    height: 140px;
    overflow: hidden;
  }

  .track-map-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .track-map-skeleton {
    height: 100%;
    background: repeating-linear-gradient(
      -45deg,
      var(--surface-2),
      var(--surface-2) 10px,
      var(--surface) 10px,
      var(--surface) 20px
    );
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .track-map-skeleton .track-placeholder {
    animation: pls 2.4s ease-in-out infinite;
  }

  .track-badge {
    position: absolute;
    top: var(--sp-2);
    left: var(--sp-2);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-tile);
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
  }

  .track-final {
    position: absolute;
    top: var(--sp-2);
    right: var(--sp-2);
  }

  .track-placeholder {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }

  .circuit-info {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: var(--sp-4) var(--sp-4) 0;
  }

  .circuit-name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 17px;
  }

  .circuit-length {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }

  .circuit-highlight {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-dim);
    padding: var(--sp-1) var(--sp-4) var(--sp-4);
  }
</style>
