---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import HeroVideo from '../components/HeroVideo.astro';
import { season, nextStage, topStandings, highlights, heroVideo } from '../data';

const upcoming = nextStage();
const top3 = topStandings(3);
const isPreSeason = season.status === 'pre-season';
const summary = highlights.lastStage ? highlights.exemplo : null;
const video = heroVideo();
---

<Base title="Início">
  <section class="hero">
    <div class="hero-heading">
      {/*
        Traçado decorativo estilizado do Autódromo José Carlos Pace (Interlagos) — marca d'água de
        telemetria, não um mapa técnico: só sugere o "S" do Senna (o pequeno zigue-zague perto do
        início), a Curva do Sol (a curva larga superior) e a reta oposta / subida dos boxes.
        Trocar futuramente pelo traçado real da próxima etapa (circuitCode de stages.json).
      */}
      <svg
        class="hero-heading-track"
        viewBox="0 0 400 260"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M60,206 C54,178 68,152 94,150
             C110,149 108,166 123,166
             C138,166 136,147 152,139
             C188,122 194,78 236,54
             C276,31 322,42 336,78
             C349,109 345,149 329,174
             C316,194 297,205 268,208
             C230,212 182,215 142,213
             C106,211 76,227 60,206 Z"
        />
      </svg>
      <p class="kicker">{season.kicker}</p>
      <h1 class="hero-title">
        ENDURANCE<br />GTONE
      </h1>
      <p class="hero-season">SEASON {season.temporada}</p>
      <p class="hero-tagline">{season.tagline}</p>
    </div>

    {video && <HeroVideo video={video} />}

    {upcoming && <Countdown stage={upcoming} />}
  </section>

  <section class="section">
    <div class="section-head">
      <span class="section-label">CAMPEONATO GERAL</span>
      <a class="section-link" href="/classificacao">VER TABELA →</a>
    </div>

    {
      isPreSeason ? (
        <div class="empty-state">
          <span class="kicker">PRÉ-TEMPORADA</span>
          <p>A classificação abre depois da Etapa 1.</p>
        </div>
      ) : (
        <ul class="leaders">
          {top3.map((row) => (
            <li class="leader-row">
              <span class="leader-pos">{row.pos}</span>
              <span class="leader-name">
                {row.name}
                <span class="label-mono">GRID {row.grid}</span>
              </span>
              <span class="leader-pts">{row.points}</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    summary && (
      <section class="section">
        <div class="section-head">
          <span class="section-label">RESUMO · {summary.stageLabel}</span>
        </div>
        <div class="summary-cards">
          <div class="card card-gold-border">
            <p class="label-mono">PILOTO DA NOITE</p>
            <p class="summary-name">{summary.pilotoDaNoite.name}</p>
            <p class="summary-detail">{summary.pilotoDaNoite.detail}</p>
          </div>
          <div class="card card-accent-border">
            <p class="label-mono">MAIOR ESCALADOR</p>
            <p class="summary-name">
              {summary.maiorEscalador.name} <span class="badge">{summary.maiorEscalador.value}</span>
            </p>
            <p class="summary-detail">{summary.maiorEscalador.detail}</p>
          </div>
          <div class="card card-accent-border">
            <p class="label-mono">PILOTO MAIS LIMPO</p>
            <p class="summary-name">
              {summary.pilotoMaisLimpo.name} <span class="badge">{summary.pilotoMaisLimpo.value}</span>
            </p>
            <p class="summary-detail">{summary.pilotoMaisLimpo.detail}</p>
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding: var(--sp-6) var(--pad-screen) var(--sp-4);
    background: linear-gradient(180deg, var(--accent-soft) 0%, transparent 60%);
  }

  .hero-heading {
    position: relative;
  }

  .hero-heading-track {
    position: absolute;
    top: -8px;
    left: -12px;
    width: calc(100% + 24px);
    height: 210px;
    z-index: 0;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    opacity: 0.08;
    pointer-events: none;
  }

  .hero-heading .kicker {
    position: relative;
    z-index: 1;
  }

  .hero-title {
    position: relative;
    z-index: 1;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 47px;
    line-height: 0.88;
    text-transform: uppercase;
    margin-top: var(--sp-2);
    color: var(--text);
  }

  .hero-season {
    position: relative;
    z-index: 1;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 22px;
    color: var(--accent);
    text-transform: uppercase;
  }

  .hero-tagline {
    position: relative;
    z-index: 1;
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--text-dim);
    max-width: 268px;
    margin-top: var(--sp-3);
  }

  .leaders {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .leader-row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: var(--touch-min);
    padding: var(--sp-2) var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
  }

  .leader-pos {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 22px;
    color: var(--accent);
    width: 28px;
  }

  .leader-name {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
  }

  .leader-pts {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
  }

  .summary-cards {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .summary-name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    margin-top: var(--sp-1);
  }

  .summary-detail {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-dim);
    margin-top: 2px;
  }
</style>
